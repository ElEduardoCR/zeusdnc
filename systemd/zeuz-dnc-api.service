[Unit]
Description=Zeuz DNC headless API
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
User=zeuz
Group=zeuz
WorkingDirectory=/opt/zeuz/zeusdnc
Environment=PYTHONUNBUFFERED=1
Environment=ZEUZ_CONFIG_PATH=/var/lib/zeuz/runtime.json
Environment=ZEUZ_MACHINES_PATH=/var/lib/zeuz/machines.json
ExecStart=/usr/bin/python3 -m zeuz_core.headless_api
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
