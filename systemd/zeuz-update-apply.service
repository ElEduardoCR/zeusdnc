[Unit]
Description=Aplicar actualización descargada de Zeuz DNC
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/zeuz/zeusdnc
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m zeuz_core.updater --apply
ExecStartPost=/usr/bin/systemctl daemon-reload
ExecStartPost=/usr/bin/systemctl --no-block try-restart zeuz-dnc-api.service
ExecStartPost=/usr/bin/systemctl --no-block try-restart zeuz-dnc-qt.service
TimeoutStartSec=5min
