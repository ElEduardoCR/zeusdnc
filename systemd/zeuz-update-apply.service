[Unit]
Requires=zeuz-update-recover.service
Description=Instalar actualización verificada de Zeuz DNC
After=network-online.target zeuz-update-recover.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/zeuz
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /usr/local/lib/zeuz/update_runner.py
TimeoutStartSec=10min
TimeoutStopSec=120
